{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Despensa Nahuel",
  "version": "0.1.0",
  "identifier": "com.despensanahuel.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Despensa Nahuel",
        "width": 980,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
